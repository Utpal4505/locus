PORT=3002
DATABASE_URL=postgresql://postgres:password@localhost:5432/locus
BETTER_AUTH_SECRET=locus_dev_secret_key_needs_to_be_at_least_32_characters_long
BETTER_AUTH_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000

# Nodemailer SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Locus <noreply@locus.dev>

# OAuth Providers (Optional in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Token Encryption (Required for storing encrypted YouTube OAuth tokens; 32 bytes hex or base64)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# YouTube Integration OAuth (Falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET if omitted)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3002/api/youtube/callback

# Admin Authorization (Comma-separated emails allowed to access admin routes & telemetry)
ADMIN_EMAILS=

# AI Video Tagging & Batch Processing (Optional - defaults to disabled)

AI_VIDEO_TAGGING_ENABLED=false
OPENAI_API_KEY=
AI_TAGGING_MODEL=gpt-4o-mini


